# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any nesting)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python bytecode from the robot simulation
__pycache__/
*.pyc

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# demo voiceover script — local only, never commit
docs/demo-voiceover.md

# Webots editor scratch files (regenerate on every open)
robot-sim/worlds/.*.wbproj
robot-sim/worlds/.*.jpg
