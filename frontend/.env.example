# --- x402 payment layer (Hedera testnet) ---
# Leave everything empty (or set X402_MODE=mock) to run the full demo with
# simulated settlement. Fill in for live x402 payments on Hedera testnet.
X402_MODE=
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com

# Warehouse operator account that RECEIVES order payments (account id only)
PAY_TO_ACCOUNT=0.0.xxxx

# Buying agent (funded ECDSA testnet account — portal.hedera.com/faucet).
# Server-side only; never exposed to the browser.
HEDERA_AGENT_ID=0.0.yyyy
HEDERA_AGENT_KEY=

# --- Hedera Consensus Service audit trail (operator submits HCS messages) ---
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# --- Public constants ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_EXPLORER=https://hashscan.io/testnet
NEXT_PUBLIC_OWNER_ACCOUNT=0.0.0

# Audit trail topic — auto-created on first order when left blank.
NEXT_PUBLIC_HCS_TOPIC=

# Order registry contract (node scripts/deploy-contract.mjs).
# When blank the hub selects robots itself and phase ordering is not enforced.
NEXT_PUBLIC_REGISTRY_CONTRACT=

# Tokenized inventory + robot digital twins (node scripts/mint-tokens.mjs).
NEXT_PUBLIC_TOKEN_GREEN=0.0.0
NEXT_PUBLIC_TOKEN_PURPLE=0.0.0
NEXT_PUBLIC_TOKEN_BLUE=0.0.0
NEXT_PUBLIC_ROBOT_PICKING=0.0.0
NEXT_PUBLIC_ROBOT_PACKING=0.0.0
NEXT_PUBLIC_ROBOT_DELIVERY=0.0.0

# --- Services (both optional; graceful fallbacks) ---
PINATA_JWT=
NEXT_PUBLIC_GATEWAY=

# Local Webots simulation access
SIMULATION_PASSWORD=

# Real wallet (HashPack) connection — free id at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
